{
  "uid": "sentineldrift",
  "title": "SentinelDrift \u2014 live MLOps",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total saved predictions",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "sentinel_predictions_total_saved",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Reviewed labels",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "sentinel_reviewed_labels",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Reviewed error (-1 = unavailable)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "sentinel_reviewed_error_ratio",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Serving model",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "sentinel_serving_model",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "API requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_http_requests_total[2m]))",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sentinel_http_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 7,
      "title": "Feature distribution shift (PSI)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "sentinel_feature_psi",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 8,
      "title": "Recovery jobs by outcome",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "expr": "sentinel_recovery_jobs",
          "refId": "A",
          "legendFormat": "{{feature}}{{status}}{{version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    }
  ]
}